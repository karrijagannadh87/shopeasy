# ── ShopEasy Frontend ─────────────────────────────────────────
# Copy to .env.local. Nothing is required in development.

# Where the Express API lives (Next.js proxies /api/* to it).
# In production (Vercel), point this at your Railway backend URL.
API_URL=http://localhost:5000

# Optional: public Stripe key (only needed for inline Elements flows).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
