# ── ShopEasy Backend Environment ──────────────────────────────
# Copy to .env and fill in. Everything except JWT_SECRET is optional
# for DEMO MODE — the API falls back to embedded Postgres (PGlite),
# in-memory cache, simulated Stripe, and a heuristic AI brain.

PORT=5000

# PostgreSQL — set this to use a real database (local, Railway, Neon, …).
# Leave blank to use embedded PGlite (real Postgres compiled to WASM).
DATABASE_URL=

# Redis — set this to use Redis caching (local, Upstash, Railway, …).
# Leave blank to use an in-memory cache with the same API.
REDIS_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Stripe — leave blank for demo payments (no real charges).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Public URL of the frontend (used in Stripe redirects)
FRONTEND_URL=http://localhost:3000

# MCP AI server (Python). Path is relative to shopping-backend/.
MCP_SERVER_PATH=../mcp-server/mcp_server.py
MCP_PYTHON=python3
# Base URL the MCP server should use to reach this API in demo mode.
SHOP_API_URL=http://localhost:5000/api

# CORS origins (comma separated). * allows all.
CORS_ORIGINS=*
